# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# ---- Flask ----
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string
# Set to "production" to enable secure cookies and disable debug mode
FLASK_ENV=development

# ---- Session expiry ----
SESSION_LIFETIME_MINUTES=60
SESSION_IDLE_MINUTES=20

# ---- Email (Gmail app password) ----
# Google Account > Security > 2-Step Verification > App passwords
OWN_EMAIL=you@gmail.com
OWN_PASSWORD=your_16_char_app_password
TO_EMAIL=you@gmail.com

# ---- Admin login ----
ADMIN_USERNAME=admin
# Option A (preferred): store a hash instead of plaintext.
#   Generate:  python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
# ADMIN_PASSWORD_HASH=scrypt:...
# Option B (works but less secure): plaintext, hashed at startup.
ADMIN_PASSWORD=change_me_to_a_strong_password

# ---- Google Drive user storage ----
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
# Service account (server-to-server, no browser login). Preferred in production:
# paste the key's raw JSON into this env var (e.g. on Render) so no file is needed.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# DRIVE_FOLDER_ID=
DRIVE_FOLDER_NAME=WebsiteUsers
# Local fallback store path (point at a Render Disk for persistence without Drive)
# USERS_LOCAL_FILE=/var/data/users.local.json
